WEB_API_PORT=3123
HTTPS_WEB_PORT=4123
DATABASE_PATH=./data/ssytdlp.sqlite
PASSKEY_RP_ID=music.example.com
PASSKEY_ORIGIN=https://music.example.com:4000
# Android uses browser passkey login with PKCE; no app signing certificate settings are needed.
# Optional trusted certificate paths. A local certificate is generated under data/tls when omitted.
# HTTPS_KEY_PATH=/absolute/path/to/server-key.pem
# HTTPS_CERT_PATH=/absolute/path/to/server-cert.pem
# MaximumImpled by each HTTP/HTTPS listener.
MAX_CONNECTIONS=500
# Optional Windows host folder for local iTunes imports in Docker (default: ./import-storage).
# IMPORT_STORAGE_PATH=C:/MusicImports
# For native Node execution only, override the local import folder with IMPORT_STORAGE_ROOT.
# IMPORT_STORAGE_ROOT=C:/MusicImports
# Set only when requests arrive through a trusted reverse proxy (for example, 1 hop).
# TRUST_PROXY=1
# If the proxy runs on another machine, set this
# DOCKER_BIND_ADDRESS=192.168.6.66
# use TRANSCRIPTION_ENDPOINT=http://host.docker.internal:4317/api/transcribe if not using DOCKER_BIND_ADDRESS
TRANSCRIPTION_ENDPOINT=http://<DOCKER_BIND_ADDRESS>:4317/api/transcribe