{
  "name": "ssytdlp-server",
  "version": "1.0.0",
  "description": "YouTube Music yt-dlp job server",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "npm run build && node --import=dotenv/config src/server.js",
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "setup:deno": "node scripts/setup-deno-runtime.mjs",
